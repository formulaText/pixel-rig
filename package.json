{
  "name": "pixel-rig",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "verify:originals": "node scripts/verify-originals.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run verify:originals && npm run typecheck && npm run build && npm test",
    "test:browser": "node tests/browser/compare-v5.mjs && node tests/browser/site-smoke.mjs && node tests/browser/validation.mjs && node tests/browser/validation-built.mjs",
    "test:character": "node tests/browser/character-stability.mjs",
    "test:character-performance": "node tests/browser/character-performance.mjs"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.128.0",
    "playwright-core": "1.57.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
